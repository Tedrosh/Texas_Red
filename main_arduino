// DISTANCE functions
// ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————

bool testIfOrientedWithDistance() {
  // read and compute first distance
  digitalWrite(pin_trig_1, LOW);
  delay(2);
  digitalWrite(pin_trig_1, HIGH);
  delay(10);
  digitalWrite(pin_trig_1, LOW);

  timing = pulseIn(pin_echo_1, HIGH);
  distance_1 = (timing * 0.034) / 2;

  // read and compute second distance
  digitalWrite(pin_trig_2, LOW);
  delay(2);
  digitalWrite(pin_trig_2, HIGH);
  delay(10);
  digitalWrite(pin_trig_2, LOW);

  timing = pulseIn(pin_echo_2, HIGH);
  distance_2 = (timing * 0.034) / 2;

  // two cycle memory
  prev_2_distance_sum = prev_distance_sum;
  prev_distance_sum = distance_sum;
  distance_sum = distance_1 + distance_2;

  // facing forward vs back
  bool condition_1 = distance_1 > distance_2;

  // within 10cm of target total distance
  bool condition_2 = (distance_sum > total_distance-2) && (distance_sum < total_distance+2);

  Serial.print("D1: ");
  Serial.print(distance_1);
  Serial.print(", D2: ");
  Serial.print(distance_2);
  Serial.print(", total: ");
  Serial.println(distance_sum);

  // test if above conditions are met and at low minimum
  if (condition_1 && condition_2 &&
    prev_2_distance_sum > prev_distance_sum &&
    prev_distance_sum < distance_sum) {
    return true;
  } else {
    return false;
  }
}


