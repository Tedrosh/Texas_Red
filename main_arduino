void handleDrivingActions(void) {
  if (prev_action != action) {
    prev_action = action;
    switch(action) {
      case ACTION_MOVE_FORWARD:
        handleMoveForward();
        break;

      case ACTION_MOVE_BACKWARD:
        handleMoveBackward();
        break;

      case ACTION_TURN_LEFT:
        handleTurnLeft();
        break;
      
      case ACTION_TURN_RIGHT:
        handleTurnRight();
        break;
      
      case ACTION_OFF:
        handleActionOff();
        break;
    }
  }
  // if (line_following_enabled) {
  //   do_line_following();
  // }
  return;
}

void do_line_following(void) {
  // positive line_following_wheel_balance favors left wheel
  if (curr_line_sensors[LINE_SENS_L]) {
    line_following_wheel_balance -= LINE_FOLLOWING_FACTOR;
  }
  if (curr_line_sensors[LINE_SENS_R]) {
    line_following_wheel_balance += LINE_FOLLOWING_FACTOR;
  }
  // avoid dividing by zero
  line_following_wheel_balance = constrain(line_following_wheel_balance, 0.3, 3.0);

  if (line_following_wheel_balance == 1.0) {
    analogWrite(DRIVING_pin_ENA, DRIVE_SPEED);
    analogWrite(DRIVING_pin_ENB, DRIVE_SPEED);
  }
  else if (line_following_wheel_balance > 1.0) {
    analogWrite(DRIVING_pin_ENA, DRIVE_SPEED);
    analogWrite(DRIVING_pin_ENB, (int)(DRIVE_SPEED / line_following_wheel_balance));
  }
  else if (line_following_wheel_balance < 1.0) {
    analogWrite(DRIVING_pin_ENA, (int)(DRIVE_SPEED / line_following_wheel_balance));
    analogWrite(DRIVING_pin_ENB, DRIVE_SPEED);
  }
  // decaying offset
  line_following_wheel_balance += /*not sure + or - */ (line_following_wheel_balance-1) * (1 - LEAKY_INTEGRATION_FACTOR); 
}

void enable_line_following(bool enable) {
  line_following_enabled = enable;
  return;
}

