// ACTUAL DIRECTIONS OF ROBOT
void handleMoveForward(void) {
  Serial.println("handleMoveForward() called");
  setLeftForward();
  setRightForward();
  return;
}

void handleMoveBackward(void) {
  Serial.println("handleMoveBackward() called");
  setLeftReverse();
  setRightReverse();
  return;
}

void handleTurnLeft(void) {
  Serial.println("handleTurnLeft() called");
  setRightForward();
  setLeftReverse();
  return;
}

void handleTurnRight(void) {
  Serial.println("handleTurnRight() called");
  setLeftForward();
  setRightReverse();
  return;
}

void handleActionOff(void) {
  Serial.println("handleActionOff() called");
  setLeftOff();
  setRightOff();
  return;
}

// FORWARD, REVERSE, STOP FOR EACH SIDE L/R
void setLeftForward(void) {
  digitalWrite(DRIVING_pin_IN1, HIGH);
  digitalWrite(DRIVING_pin_IN2, LOW);
  return;
}
void setLeftReverse(void) {
  digitalWrite(DRIVING_pin_IN1, LOW);
  digitalWrite(DRIVING_pin_IN2, HIGH);
  return;
}
void setLeftOff(void) {
  digitalWrite(DRIVING_pin_IN1, LOW);
  digitalWrite(DRIVING_pin_IN2, LOW);
  return;
}
void setLeftActiveBrake(void) {
  digitalWrite(DRIVING_pin_IN1, HIGH);
  digitalWrite(DRIVING_pin_IN2, HIGH);
  return;
}
void setRightForward(void) {
  digitalWrite(DRIVING_pin_IN3, HIGH);
  digitalWrite(DRIVING_pin_IN4, LOW);
  return;
}
void setRightReverse(void) {
  digitalWrite(DRIVING_pin_IN3, LOW);
  digitalWrite(DRIVING_pin_IN4, HIGH);
  return;
}
void setRightOff(void) {
  digitalWrite(DRIVING_pin_IN3, LOW);
  digitalWrite(DRIVING_pin_IN4, LOW);
  return;
}
void setRightActiveBrake(void) {
  digitalWrite(DRIVING_pin_IN3, HIGH);
  digitalWrite(DRIVING_pin_IN4, HIGH);
  return;
}


