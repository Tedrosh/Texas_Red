// DRIVING setup
// ———————————————————————————————————————————————————————————————————————————————————————————————————————————————————

// H_BRIDGE PINS
#define DRIVING_pin_ENA 3 // PWM
#define DRIVING_pin_IN1 7
#define DRIVING_pin_IN2 6 // Swapped to fix polarity
#define DRIVING_pin_IN3 8
#define DRIVING_pin_IN4 9
#define DRIVING_pin_ENB 5 // PWM
// TOTAL PINS 6

// WHEEL ACTIONS
// one of these is always selected
typedef enum {
  ACTION_MOVE_FORWARD,
  ACTION_MOVE_BACKWARD,
  ACTION_TURN_LEFT,
  ACTION_TURN_RIGHT,
  ACTION_OFF,
  ACTION_DUMMY
} Actions_t;
Actions_t action = ACTION_OFF;
Actions_t prev_action = ACTION_DUMMY;

// up to 255
#define DRIVE_SPEED 150
#define TURN_SPEED 210


bool line_following_enabled = false;
#define LINE_FOLLOWING_FACTOR 0.1f
#define LEAKY_INTEGRATION_FACTOR 0.01f
float line_following_wheel_balance = 1.0;


void setDriveSpeed(void) {
  analogWrite(DRIVING_pin_ENA, DRIVE_SPEED);
  analogWrite(DRIVING_pin_ENB, DRIVE_SPEED);
  return;
}

void setTurnSpeed(void) {
  analogWrite(DRIVING_pin_ENA, TURN_SPEED);
  analogWrite(DRIVING_pin_ENB, TURN_SPEED);
  return;
}

void setup_driving(void) {
  pinMode(DRIVING_pin_ENA, OUTPUT);
  pinMode(DRIVING_pin_IN1, OUTPUT);
  pinMode(DRIVING_pin_IN2, OUTPUT);
  pinMode(DRIVING_pin_IN3, OUTPUT);
  pinMode(DRIVING_pin_IN4, OUTPUT);
  pinMode(DRIVING_pin_ENB, OUTPUT);

  // required redundancy in enable pins ( eye roll )
  pinMode(12, OUTPUT);
  pinMode(13, OUTPUT);
  digitalWrite(12, HIGH);
  digitalWrite(13, HIGH);

  // analogWrite(DRIVING_pin_ENA, TURN_SPEED);
  // analogWrite(DRIVING_pin_ENB, TURN_SPEED);
  setTurnSpeed();
  return;
}



